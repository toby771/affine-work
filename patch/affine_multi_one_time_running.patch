+def load_mockup_candidates(path):
+    path = Path(path)
+    if path.is_symlink():
+        raise ValueError('mockup candidate state must not be a symlink')
+    try:
+        raw = path.read_bytes()
+    except FileNotFoundError:
+        return {}
+    if len(raw) > 1024 * 1024:
+        raise ValueError('mockup candidate state exceeds size limit')
+    value = json.loads(raw)
+    if (type(value) is not dict or set(value) != {'version', 'environments'}
+            or value['version'] != 1 or type(value['environments']) is not dict):
+        raise ValueError('invalid mockup candidate state')
+    result = {}
+    for env_id, indices in value['environments'].items():
+        if (type(env_id) is not str or not env_id or type(indices) is not list
+                or any(type(index) is not int or index < 0 for index in indices)
+                or len(indices) != len(set(indices))):
+            raise ValueError('invalid mockup candidate entries')
+        result[env_id] = indices
+    return result
+
+
+def save_mockup_candidates(path, environments):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    if path.is_symlink():
+        raise ValueError('mockup candidate state must not be a symlink')
+    for env_id, indices in environments.items():
+        if (type(env_id) is not str or not env_id or type(indices) is not list
+                or any(type(index) is not int or index < 0 for index in indices)
+                or len(indices) != len(set(indices))):
+            raise ValueError('invalid mockup candidate entries')
+    payload = json.dumps({'version': 1, 'environments': environments},
+                         sort_keys=True, separators=(',', ':')).encode()
+    descriptor, temporary = tempfile.mkstemp(prefix=path.name + '.', dir=path.parent)
+    try:
+        os.fchmod(descriptor, 0o600)
+        with os.fdopen(descriptor, 'wb') as stream:
+            stream.write(payload)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def append_prepared_rollout(path, batch):
+    """Append one converted batch for inspection without changing upload state."""
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
+    try:
+        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
+            raise ValueError('prepared rollout output must be a regular file')
+        os.fchmod(descriptor, 0o600)
+        payload = (json.dumps(batch, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()
+        with os.fdopen(descriptor, 'ab', closefd=False) as stream:
+            stream.write(payload)
+            stream.flush()
+            os.fsync(stream.fileno())
+    finally:
+        os.close(descriptor)
+
