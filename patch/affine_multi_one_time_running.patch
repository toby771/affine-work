+def pick_batch(logits, uniforms, temperature, top_p):
+    import torch
+
+    # logits:   [B, V]
+    # uniforms: [B], one deterministic draw per rollout
+    probabilities = torch.softmax(logits.float() / temperature, dim=-1)
+
+    if top_p < 1:
+        values, indices = torch.sort(probabilities, dim=-1, descending=True, stable=True)
+        values = torch.where(values.cumsum(dim=-1) - values >= top_p, 0.0, values)
+        probabilities = torch.zeros_like(probabilities).scatter(-1, indices, values)
+        probabilities = probabilities / probabilities.sum(dim=-1, keepdim=True)
+
+    if not torch.isfinite(probabilities).all() or (probabilities.sum(dim=-1) <= 0).any():
+        raise RuntimeError("nonfinite sampling distribution; infrastructure failure")
+
+    # Preserve the full 53-bit public uniform draw.
+    probabilities = probabilities.double()
+    probabilities = probabilities / probabilities.sum(dim=-1, keepdim=True)
+    cumulative = probabilities.cumsum(dim=-1)
+    # Avoid a rounded cumulative sum ending below 1.
+    cumulative[:, -1] = 1.0
+    selected = torch.searchsorted(cumulative.contiguous(), uniforms.to(device=cumulative.device, dtype=torch.float64).unsqueeze(-1), right=True).squeeze(-1)
+    if (selected >= probabilities.shape[-1]).any() or (probabilities.gather(1, selected.clamp(max=probabilities.shape[-1] - 1).unsqueeze(-1)) <= 0).any():
+        raise RuntimeError("invalid sampling interval; infrastructure failure")
+    return selected.tolist()
 
