+def prioritize_authorized_tasks(choices, env_id, preferred_indices):
+    authorized = set(choices)
+    preferred = []
+    seen = set()
+    for index in preferred_indices:
+        task = (env_id, index)
+        if task in authorized and task not in seen:
+            preferred.append(task)
+            seen.add(task)
+    return preferred + [task for task in choices if task not in seen]
+
+
+def phase_tasks(choices, env_id, listed_indices, *, mockup, excluded=(), rng=None):
+    """Prioritize saved candidates, then listed IDs, then the authorized mockup remainder."""
+    if type(mockup) is not bool:
+        raise ValueError('explicit live/mockup phase required')
+    if (not isinstance(listed_indices, list) or
+            any(type(index) is not int or index < 0 for index in listed_indices) or
+            len(listed_indices) != len(set(listed_indices))):
+        raise ValueError('prepared sample IDs must be unique nonnegative integers')
+    available = set(choices)
+    excluded = set(excluded)
+    if mockup:
+        listed = [(env_id, index) for index in listed_indices
+                  if (env_id, index) in available and (env_id, index) not in excluded]
+        listed_ids = set(listed_indices)
+        remainder = [task for task in choices
+                     if task[0] == env_id and task[1] not in listed_ids and task not in excluded]
+        (rng or random.SystemRandom()).shuffle(remainder)
+        return listed + remainder
+    return [(env_id, index) for index in listed_indices
+            if (env_id, index) in available and (env_id, index) not in excluded]
+
