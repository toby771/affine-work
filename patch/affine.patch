+    context = runtime.sampling_context
+    for attempt in attempts:
+        validate_attempt(context, attempt)
+
+    print("Batch cached sampling...")
+
+    config = validate_harness(runtime.harness, context["contract"])
+    device = next(runtime.model.parameters()).device
+    stop = runtime.tokenizer.eos_token_id
+    prompt_length = len(prompts[0])
+    if any(len(prompt) != prompt_length for prompt in prompts):
+        raise ValueError("all prompts must have equal length")
+
+    outputs = [[] for _ in range(batch_size)]
+    active = list(range(batch_size))
