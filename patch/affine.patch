+def pick_batch(logits, uniforms, temperature, top_p):
+    import torch
+
+    # logits:   [B, V]
+    # uniforms: [B], one deterministic draw per rollout
+    probabilities = torch.softmax(logits.float() / temperature, dim=-1)
+
+    if top_p < 1:
+        values, indices = torch.sort(probabilities, dim=-1, descending=True, stable=True)
+        values = torch.where(values.cumsum(dim=-1) - values >= top_p, 0.0, values)
+        probabilities = torch.zeros_like(probabilities).scatter(-1, indices, values)
