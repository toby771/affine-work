+    cache = None
+
+    with torch.inference_mode():
+        for position in range(config["max_output_tokens"]):
+            result = runtime.model(tokens, past_key_values=cache, use_cache=True)
+            logits = result.logits[:, -1, :]
+            cache = result.past_key_values
+
+            uniforms = torch.tensor(
+              [uniform(context, runtime.spec.id, task_hashes[i], index, attempts[i], turn, position) for i in active],
+              dtype=torch.float64,
+              device=device,
+            )
+
+            sampled = pick_batch(logits, uniforms, config["temperature"], config["top_p"])
