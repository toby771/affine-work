+                if token != stop:
+                    keep_rows.append(row)
+                    next_active.append(i)
+                    next_tokens.append(token)
+            
+            del result, logits
+            if not next_active:
+                break
+
+            if len(next_active) != len(active):
+                keep = torch.tensor(keep_rows, dtype=torch.long, device=device)
+                cache = select_cache_batch(cache, keep)
+
+            active = next_active
+            tokens = torch.tensor(next_tokens, dtype=torch.long, device=device).unsqueeze(1)
